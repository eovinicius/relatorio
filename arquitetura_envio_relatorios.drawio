ounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="email_api" target="worker"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" value="registra Sent / Failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;dashed=1;" edge="1" parent="1" source="worker" target="api_prefs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a7" value="persistência" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="api_prefs" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="m5" value="preferências / controle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748b;strokeWidth=1;dashed=1;" edge="1" parent="1" source="api_data" target="db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lib_shared" value="Reports.PdfGenerator&lt;br&gt;&lt;font style='font-size:11px'&gt;Recebe dados e retorna PDF.&lt;br/&gt;Sem dependência de banco, HTTP, e-mail ou AWS.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#14532d;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="755" width="330" height="85" as="geometry"/></mxCell><mxCell id="email_shared" value="API de e-mail existente&lt;br&gt;&lt;font style='font-size:11px'&gt;Consumida pelo BFF (envio manual)&lt;br/&gt;e pelo Worker (envio mensal).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="480" y="755" width="300" height="85" as="geometry"/></mxCell><mxCell id="db_shared" value="Banco de dados existente&lt;br&gt;&lt;font style='font-size:11px'&gt;ClientReportPreference&lt;br/&gt;ReportEmailDispatch&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=13;spacing=8;" vertex="1" parent="1"><mxGeometry x="830" y="755" width="260" height="85" as="geometry"/></mxCell><mxCell id="note1" value="Decisões / cuidados:&lt;br/&gt;• Envio manual não bloqueia o automático.&lt;br/&gt;• Idempotência do automático por cliente + mês + tipo.&lt;br/&gt;• Falhas por cliente não devem interromper o lote.&lt;br/&gt;• Retry somente para falhas transitórias; verificar idempotência da API de e-mail.&lt;br/&gt;• Sem SQS inicialmente; reavaliar se volume/tempo/retentativas exigirem." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#fb923c;fontColor=#7c2d12;fontSize=12;size=18;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="1120" height="105" as="geometry"/></mxCell>
